cff-version: 1.2.0
title: "immune-repertoire-pipelines: reproducible R workflows for adaptive immune receptor repertoire and single-cell transcriptome analysis"
message: "If you use this software, please cite it as below."
type: software
authors:
  - family-names: "Sbihi"
    given-names: "Zineb"
    orcid: "https://orcid.org/0000-0002-6695-7695"
